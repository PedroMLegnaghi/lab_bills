# Postgres. Locally: `npm run db:start` prints this URL (Prisma's built-in dev server, no Docker).
# On Vercel the Neon integration sets DATABASE_URL and DATABASE_URL_UNPOOLED for you.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Shared code a new member must type to sign up. Tell it to the lab in person.
LAB_ACCESS_CODE="troque-este-codigo"
# Receipts go to ./uploads locally. On Vercel, connect a *private* Blob store to the project;
# it sets BLOB_STORE_ID and the app switches to it automatically. Never inside public/.
UPLOADS_DIR="./uploads"
